# Postgres connection string (Neon: use the pooled connection string, with ?sslmode=require)
DATABASE_URL=postgresql://payroll:payroll@localhost:5432/payroll_dev
# Random 32+ character secret: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me
# Public URL of the app (http://localhost:3000 locally, https://<site>.netlify.app in production)
BETTER_AUTH_URL=http://localhost:3000
